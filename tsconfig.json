{
  "compilerOptions": {
    "preserveConstEnums": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "sourceMap": false,
    "allowJs": true,
    "allowUnreachableCode": false,
    "target": "es2020",
    "outDir": "build",
    "moduleResolution": "node",
    "lib": ["es2020"],
    "rootDir": "./",
    "strict": true,
    "module": "commonjs",
    "esModuleInterop": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "/build/**/*", "**/*.spec.ts", "**/*.test.ts", "jest.config.js"]
}