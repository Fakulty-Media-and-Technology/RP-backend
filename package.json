{
  "name": "reeplay-backend",
  "version": "1.0.0",
  "description": "reeplay mobile app, netflix and other similar apps compatible",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prest": "nodemon --exec \"npm run format && node\" src/index.js",
    "dev": "cross-env MONGO_DB_URL=mongodb://localhost:27017/reeplay NODE_ENV=development nodemon -e ts --watch src .env --exec \"tsc --incremental && node build/src/index.js\" || exit 1",
    "start": "cross-env NODE_ENV=production node build/src/index.js",
    "prestart": "npm run build",
    "build": "rimraf build && tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.812.0",
    "@aws-sdk/client-s3": "^3.577.0",
    "@aws-sdk/cloudfront-signer": "^3.598.0",
    "@aws-sdk/lib-storage": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.577.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.6.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "firebase-admin": "^13.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "http-status": "^2.0.0",
    "jest": "^30.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.8.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "node-media-server": "^2.7.0",
    "nodemailer": "^7.0.3",
    "paystack-sdk": "^2.5.17",
    "rimraf": "^6.0.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node-cron": "^3.0.11",
    "@types/node-media-server": "^2.3.7",
    "@types/nodemailer": "^6.4.17",
    "chai": "^5.1.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
