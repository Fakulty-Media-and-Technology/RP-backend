# Dockerfile for nginx-rtmp streaming server
# Based on tiangolo/nginx-rtmp with ffmpeg for transcoding
# Domain: obs.reeplay.app

FROM tiangolo/nginx-rtmp:latest

# Install ffmpeg for transcoding and curl for healthcheck
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create directories for HLS output
RUN mkdir -p /tmp/hls && chmod 755 /tmp/hls

# Copy custom nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Expose ports:
# 1935 - RTMP
# 8080 - HLS HTTP
EXPOSE 1935 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1
