# Dockerfile for nginx-rtmp + Node.js combined
# Based on tiangolo/nginx-rtmp with Node.js added
# Domain: obs.reeplay.app

FROM tiangolo/nginx-rtmp:latest

# Install Node.js 20, ffmpeg, and utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    ca-certificates \
    gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /tmp/hls && chmod 755 /tmp/hls
RUN mkdir -p /app

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install Node.js dependencies
RUN npm ci --omit=dev

# Copy the rest of the application
COPY . .

# Build TypeScript if needed
RUN npm run build || true

# Forward nginx logs to Docker stdout/stderr
RUN ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log

# Copy custom nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Expose ports:
# 3000 - Node.js API
# 1935 - RTMP
# 8080 - HLS HTTP
EXPOSE 3000 1935 8080

# Create startup script
RUN cat > /start.sh << 'EOF'
#!/bin/bash
set -e

echo "Starting Node.js app..."
cd /app
node build/src/index.js &
NODE_PID=$!

echo "Waiting for Node.js to be ready on port 3000..."
for i in {1..30}; do
    if curl -s http://127.0.0.1:3000 > /dev/null 2>&1; then
        echo "Node.js is ready!"
        break
    fi
    echo "Attempt $i: Node.js not ready yet..."
    sleep 1
done

echo "Starting nginx-rtmp..."
nginx -g "daemon off;" &
NGINX_PID=$!

# Handle shutdown
trap "kill $NODE_PID $NGINX_PID 2>/dev/null; exit 0" SIGTERM SIGINT

# Wait for either process to exit
wait -n $NODE_PID $NGINX_PID
EXIT_CODE=$?

# If one exits, kill the other
kill $NODE_PID $NGINX_PID 2>/dev/null || true
exit $EXIT_CODE
EOF

RUN chmod +x /start.sh

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000 && curl -f http://localhost:8080/health || exit 1

CMD ["/start.sh"]